# HTCondor submit file — RQ4 transfer benchmark for the 50-epoch (lr 3e-5) encoder.
#
# Arms (benchmark_al.py, RUN_TAG = "50ep"): the epoch-level run's best epoch (23) and final
# epoch (26), the 10-epoch lr-1e-4 encoder, random-init Chemprop and CheMeleon, on all four
# targets x 3 surrogates x greedy/EI x 4 budget configurations x 5 seeds.
# Output: experiments/al_benchmark_parts_50ep/<target>.csv (refuses to overwrite).
# Submit from the repo root:  condor_submit cluster/run_gpu_benchmark_50ep.sub
universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_benchmark_50ep.sh
arguments               = $(TARGET)

output                  = runlogs/run_gpu_benchmark_50ep_$(TARGET).$(ClusterId).out
error                   = runlogs/run_gpu_benchmark_50ep_$(TARGET).$(ClusterId).err
log                     = runlogs/run_gpu_benchmark_50ep.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 4
request_memory          = 4GB
require_gpus            = (GlobalMemoryMb >= 40000)

requirements            = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

queue TARGET in (saureus, tyk2, usp7, d2r)
