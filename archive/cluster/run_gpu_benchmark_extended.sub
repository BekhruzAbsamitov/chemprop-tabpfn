# HTCondor submit file — follow-up AL experiments of the 2026-09-29 supervision (E2-E6).
#
#   acquisition  (12 jobs: 4 targets x CheMeleon / Morgan / random-init Chemprop) EI/PI vs y+ and y_thresh, Gaussian vs full TabPFN posterior,
#                         Tanimoto-kernel GP on Morgan, mean activity of acquired compounds
#   subsampling  (2 jobs) 1,000-candidate subsample vs the full pool (D2R, USP7)
# One job per (experiment, target, representation); outputs in experiments/benchmark_extended/.
# Each job refuses to overwrite its CSV, so a requeue after maintenance cannot destroy results.
#
# Submit from the repo root:  condor_submit cluster/run_gpu_benchmark_extended.sub
universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_benchmark_extended.sh
arguments               = $(EXPERIMENT) $(TARGET) $(REPRESENTATION)
output                  = runlogs/run_gpu_benchmark_extended_$(EXPERIMENT)_$(TARGET)_$(REPRESENTATION).$(ClusterId).out
error                   = runlogs/run_gpu_benchmark_extended_$(EXPERIMENT)_$(TARGET)_$(REPRESENTATION).$(ClusterId).err
log                     = runlogs/run_gpu_benchmark_extended.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 4
request_memory          = 4GB
require_gpus            = (GlobalMemoryMb >= 40000)
requirements            = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

queue EXPERIMENT, TARGET, REPRESENTATION from (
    acquisition, saureus, chemeleon
    acquisition, saureus, morgan
    acquisition, tyk2, chemeleon
    acquisition, tyk2, morgan
    acquisition, usp7, chemeleon
    acquisition, usp7, morgan
    acquisition, d2r, chemeleon
    acquisition, d2r, morgan
    acquisition, saureus, chemprop_untrained
    acquisition, tyk2, chemprop_untrained
    acquisition, usp7, chemprop_untrained
    acquisition, d2r, chemprop_untrained
    subsampling, d2r, chemeleon
    subsampling, usp7, chemeleon
)
