# Encoder training on the domain-matched S. aureus set for 100,000 steps (run_experiment.py, preset "saureus_long").
# Needs data/curated/train_adaptive_S_aureus.parquet on the cluster.
# Validation curve: experiments/train_val_curve_saureus_long.csv
# About 1.5 to 2 days; a checkpoint is saved at every evaluation.
# Submit from the repository root, after `mkdir -p runlogs`:
#   condor_submit cluster/run_gpu_saureus_long.sub
universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_saureus_long.sh

output                  = runlogs/run_gpu_saureus_long.$(ClusterId).$(ProcId).out
error                   = runlogs/run_gpu_saureus_long.$(ClusterId).$(ProcId).err
log                     = runlogs/run_gpu_saureus_long.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 4
request_memory          = 7GB

requirements            = (UidDomain == "cs.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 40000)
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

queue 1
