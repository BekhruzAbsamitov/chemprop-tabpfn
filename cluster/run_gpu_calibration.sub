# HTCondor submit file — direct calibration study (E1): coverage-based ECE, NLL, Spearman
# for TabPFN (full and Gaussian intervals), RF, GP and the Tanimoto GP on 5 datasets.
# Output: experiments/calibration_study.csv.   Submit: condor_submit cluster/run_gpu_calibration.sub
universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_calibration.sh
output                  = runlogs/run_gpu_calibration.$(ClusterId).out
error                   = runlogs/run_gpu_calibration.$(ClusterId).err
log                     = runlogs/run_gpu_calibration.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 4
request_memory          = 4GB
require_gpus            = (GlobalMemoryMb >= 40000)
requirements            = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

# Short job (< 2 h): accept being reclaimed with up to 8 h notice. That makes the shared GPU
# machines (tig, tyr1/2, fjolnir, fornjoter) eligible; they reject jobs that leave this unset.
+MaxJobRetirementTime   = 28800

queue 1
