# How many candidates fit in one TabPFN predict call on an A100-PCIe-40GB (runtime_capacity.py).
# Output: experiments/runtime_capacity_a100.csv. The script refuses to start on any other GPU and refuses to
# overwrite its output. It writes a row with status "started" before every attempt and runs the sizes in
# ascending order, so if the job is removed for exceeding its host memory, the file ends with the setting it
# died in and every smaller size is saved. About an hour.
#
# If the dry run rejects the DeviceName expression, use this one instead (the 40 GB A100s):
#   require_gpus = (Capability == 8.0 && GlobalMemoryMb < 50000)
#
# Submit from the repository root, after `mkdir -p runlogs`:
#   condor_submit -dry-run /dev/null cluster/run_gpu_capacity_a100.sub   # validate only
#   condor_submit cluster/run_gpu_capacity_a100.sub
universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_capacity.sh
output                  = runlogs/run_gpu_capacity_a100.$(ClusterId).out
error                   = runlogs/run_gpu_capacity_a100.$(ClusterId).err
log                     = runlogs/run_gpu_capacity_a100.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 4
# Host RAM, not GPU memory. The input matrix alone is up to 3 GB (MAX_INPUT_GB in the script) and TabPFN
# copies it; a 16 GB request once left jobs idle beside free GPUs. If this job stays idle, lower it to 10GB
# (and MAX_INPUT_GB in the script to 2.0).
request_memory          = 12GB
require_gpus            = (DeviceName == "NVIDIA A100-PCIE-40GB")
requirements            = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

# Only widens the machines that accept the job; the GPU model is fixed by require_gpus.
+MaxJobRetirementTime   = 28800

queue 1
