# Encoder training on the single-protein ChEMBL set in epoch mode (run_experiment.py, preset "full_sp_50ep_seed1"):
# learning rate 3e-5, up to 50 epochs, early stopping with patience 5 on the validation loss of the
# whole validation set. About 13.4 h per epoch.
# No resume: if the job is killed, the curve CSV and one checkpoint per epoch remain, but training
# cannot continue.
# Seed-1 replicate of run_gpu_full_sp_50ep.sub, with its own output files. A requeued job refuses to
# overwrite the existing curve and checkpoints and exits.
# Validation curve: experiments/val_curve_full_sp_50ep_seed1.csv (one row per epoch)
# Submit from the repository root, after `mkdir -p runlogs`:
#   condor_submit cluster/run_gpu_full_sp_50ep_seed1.sub
universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_full_sp_50ep_seed1.sh

output                  = runlogs/run_gpu_full_sp_50ep_seed1.$(ClusterId).$(ProcId).out
error                   = runlogs/run_gpu_full_sp_50ep_seed1.$(ClusterId).$(ProcId).err
log                     = runlogs/run_gpu_full_sp_50ep_seed1.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 4
request_memory          = 7GB

requirements            = (UidDomain == "cs.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 40000)
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

queue 1
