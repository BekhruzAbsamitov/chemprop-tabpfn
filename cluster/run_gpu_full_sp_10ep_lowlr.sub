# HTCondor submit file — 10 EPOCHS on the curated single-protein set.
# 2026-08-27 supervision: "train for at least 10 epochs, monitor validation loss and
# spearman on epoch-level, plot the first 10 epochs, is there a trend to convergence?"
#
# 313,840 steps = exactly 10 epochs (1 epoch = 31,384 usable episodes). At the measured
# 1,423 s / 1,000 steps this is ~124 h = 5.2 DAYS — check the pool's wall-clock limit
# before submitting; this is 3x longer than any job this project has run.
#
# Evaluates every 3,923 steps (1/8 epoch): 80 points for the plot, every 8th landing
# exactly on an epoch boundary.
#
# The question: the 3.19-epoch run (§5h) showed in-domain val_spearman still RISING at
# the end (+0.038 +-0.012 second half vs first, t=4.27) with no sign of a plateau. This
# asks whether it converges, keeps climbing, or turns over.
#
# NO resume: a crash cannot be continued, but nothing is lost — the curve CSV is written
# incrementally and step-tagged encoders land every 3,923 steps.
#
# Submit from the repo root:  condor_submit cluster/run_gpu_full_sp_10ep.sub
#
# request_memory is HOST RAM, not VRAM. Measured usage is ~1.4GB; an oversized ask
# leaves the job IDLE beside free A100s. VRAM is requested via GPUs_GlobalMemoryMb.

universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_full_sp_10ep_lowlr.sh

output                  = runlogs/run_gpu_full_sp_10ep_lowlr.$(ClusterId).$(ProcId).out
error                   = runlogs/run_gpu_full_sp_10ep_lowlr.$(ClusterId).$(ProcId).err
log                     = runlogs/run_gpu_full_sp_10ep_lowlr.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 4
request_memory          = 7GB

requirements            = (UidDomain == "cs.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 40000)
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

queue 1
