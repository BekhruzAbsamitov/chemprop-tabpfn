# Encoder training on the single-protein ChEMBL set for 10 epochs at the lower learning rate (run_experiment.py, preset "full_sp_10ep_lowlr").
# 313,840 steps, evaluated every 3,923 steps (1/8 epoch); about 5 days.
# No resume: after a crash the curve CSV and the step-tagged encoders written so far remain, but
# training cannot continue.
# request_memory is host RAM, not GPU memory: an oversized request leaves the job idle beside free GPUs.
# Submit from the repository root, after `mkdir -p runlogs`:
#   condor_submit cluster/run_gpu_full_sp_10ep_lowlr.sub
universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_full_sp_10ep_lowlr.sh

output                  = runlogs/run_gpu_full_sp_10ep_lowlr.$(ClusterId).$(ProcId).out
error                   = runlogs/run_gpu_full_sp_10ep_lowlr.$(ClusterId).$(ProcId).err
log                     = runlogs/run_gpu_full_sp_10ep_lowlr.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 4
request_memory          = 7GB

requirements            = (UidDomain == "cs.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 40000)
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

queue 1
