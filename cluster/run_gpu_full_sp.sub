# HTCondor submit file — retrain on the 2026-08-20 single-protein curated set (GPU).
# The supervisor's stricter ChEMBL 36 cut: binding assays, single-protein targets,
# confidence 9, IC50/Ki/Kd, >=5 measurements. 34,192 train assays (5x fewer than the
# old `full` run) but far cleaner and, decisively, nearly leakage-free against the AL
# pools: S. aureus 77.2%->5.2%, D2R 91.1%->1.2%, USP7 4.4%->0.0%, TYK2 0.2%->0.0%.
#
# WHY THIS RUN MATTERS: it removes the leakage caveat that currently qualifies two of
# the four targets in report §5e. The resulting encoder replaces trained_encoder_full.pt
# as the `chemprop_trained_full` benchmark arm, so run this BEFORE the next AL benchmark
# rather than benchmarking twice.
#
# Watch experiments/train_val_curve_full_sp.csv. 100k steps ~= 2.9 passes over the set.
# Submit from the repo root:  condor_submit cluster/run_gpu_full_sp.sub
# Prereq: one-time setup (cluster/README.md) + chembl36_single_protein_clean.parquet
# synced to the cluster. ~1.5-2 days wall-clock — checkpointed at every eval.
#
# request_memory is HOST RAM, not VRAM. Measured usage is ~1.4GB; an oversized ask
# leaves the job IDLE beside free A100s. VRAM is requested via GPUs_GlobalMemoryMb.

universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_full_sp.sh

output                  = runlogs/run_gpu_full_sp.$(ClusterId).$(ProcId).out
error                   = runlogs/run_gpu_full_sp.$(ClusterId).$(ProcId).err
log                     = runlogs/run_gpu_full_sp.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 4
request_memory          = 7GB

requirements            = (UidDomain == "cs.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 40000)
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

queue 1
