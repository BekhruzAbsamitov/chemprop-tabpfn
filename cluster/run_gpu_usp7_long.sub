# Encoder training on the domain-matched USP7 set for 100,000 steps (run_experiment.py, preset "usp7_long").
# Needs data/curated/train_adaptive_USP7.parquet on the cluster.
# Validation curve: experiments/train_val_curve_usp7_long.csv
# About 1.5 to 2 days; a checkpoint is saved at every evaluation.
# Submit from the repository root, after `mkdir -p runlogs`:
#   condor_submit cluster/run_gpu_usp7_long.sub
universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_usp7_long.sh

output                  = runlogs/run_gpu_usp7_long.$(ClusterId).$(ProcId).out
error                   = runlogs/run_gpu_usp7_long.$(ClusterId).$(ProcId).err
log                     = runlogs/run_gpu_usp7_long.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 4
# Host RAM, not GPU memory. Kept low: a 16 GB request left the job idle beside free GPUs.
request_memory          = 7GB

requirements            = (UidDomain == "cs.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 40000)
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

queue 1
