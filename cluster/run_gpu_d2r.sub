# HTCondor submit file — RQ4 D2R *adaptive* run on one GPU (docker universe).
# Trains on the domain-matched, leakage-free GPCR set (train_adaptive_D2R.parquet)
# instead of all-of-ChEMBL, then watch experiments/train_val_curve_d2r.csv.
# Submit from the repo root:  condor_submit cluster/run_gpu_d2r.sub
# Prereq: run the one-time setup first (see cluster/README.md), and make sure
# train_adaptive_D2R.parquet exists on the cluster (build it, or scp it over).

universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_d2r.sh

output                  = runlogs/run_gpu_d2r.$(ClusterId).$(ProcId).out
error                   = runlogs/run_gpu_d2r.$(ClusterId).$(ProcId).err
log                     = runlogs/run_gpu_d2r.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 8
request_memory          = 32GB

requirements            = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

queue 1
