# HTCondor submit file — EPOCH-MODE training (2026-09-11 supervision).
#
#   one validation epoch = the WHOLE validation set (3,496 episodes, uncapped)
#   validation loss      = mean over all validation data points
#   lr 3e-5, up to 50 epochs, early stopping with patience 5 on validation loss
#   stops cleanly before 2026-10-01 00:00 UTC if early stopping has not fired
#
# ~13.4 h per epoch (12.4 h training + ~1 h full validation), so the deadline allows
# roughly 30 epochs. There is NO resume: if the job is killed, the curve CSV and one
# checkpoint per epoch survive up to that point, but training cannot continue.
#
# Watch: experiments/val_curve_full_sp_50ep.csv (one row per epoch)
# Plot:  uv run --with matplotlib python src/scripts/plot_epoch_curves.py
# Submit from the repo root:  condor_submit cluster/run_gpu_full_sp_50ep.sub

universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_full_sp_50ep.sh

output                  = runlogs/run_gpu_full_sp_50ep.$(ClusterId).$(ProcId).out
error                   = runlogs/run_gpu_full_sp_50ep.$(ClusterId).$(ProcId).err
log                     = runlogs/run_gpu_full_sp_50ep.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 4
request_memory          = 7GB

requirements            = (UidDomain == "cs.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 40000)
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

queue 1
