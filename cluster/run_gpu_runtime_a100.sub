# Runtime sweep on an A100-PCIe-40GB, the GPU of most benchmark campaigns (runtime_study.py).
# Output: experiments/runtime_study_a100.csv. The script refuses to start on any other GPU and refuses to
# overwrite its output, so a job that lands on the wrong GPU writes nothing and can be resubmitted.
# About half an hour to an hour.
#
# If the dry run rejects the DeviceName expression, use this one instead (the 40 GB A100s):
#   require_gpus = (Capability == 8.0 && GlobalMemoryMb < 50000)
#
# Submit from the repository root, after `mkdir -p runlogs`:
#   condor_submit -dry-run /dev/null cluster/run_gpu_runtime_a100.sub   # validate only
#   condor_submit cluster/run_gpu_runtime_a100.sub
universe                = docker
docker_image            = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable              = cluster/run_gpu_runtime.sh
output                  = runlogs/run_gpu_runtime_a100.$(ClusterId).out
error                   = runlogs/run_gpu_runtime_a100.$(ClusterId).err
log                     = runlogs/run_gpu_runtime_a100.$(ClusterId).log

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
getenv                  = HOME

request_GPUs            = 1
request_CPUs            = 4
# Host RAM. 4 GB was exceeded; 7 GB is what the benchmark jobs ask for on the same A100 hosts.
request_memory          = 7GB
require_gpus            = (DeviceName == "NVIDIA A100-PCIE-40GB")
requirements            = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted     = true
+WantScratchMounted     = true

# Only widens the machines that accept the job; the GPU model is fixed by require_gpus.
+MaxJobRetirementTime   = 28800

queue 1
